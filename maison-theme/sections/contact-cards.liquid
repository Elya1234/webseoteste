{%- comment -%}
  MAISON — Rencontrons-nous
  Image + 4 cartes de contact. Chaque carte n'apparaît que si son lien est
  réellement configuré : pas de numéro inventé, pas de faux bouton chat.
{%- endcomment -%}
<section class="section contact">
  <div class="page">
    <div class="contact__grid">
      <div class="frame contact__frame" data-reveal="mask">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 45vw, 100vw', widths: '600,900,1400', alt: section.settings.image_alt }}
        {%- else -%}
          {% render 'maison-placeholder', label: 'Rencontrons-nous' %}
        {%- endif -%}
      </div>

      <div class="contact__cards">
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="t-h1 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
        {%- endif -%}

        <div class="contact__grid-cards" style="margin-top: var(--s-6)">
          {%- for block in section.blocks -%}
            {%- liquid
              assign href = blank
              case block.type
                when 'phone'
                  if block.settings.phone != blank
                    assign href = 'tel:' | append: block.settings.phone | remove: ' '
                  endif
                when 'email'
                  if block.settings.email != blank
                    assign href = 'mailto:' | append: block.settings.email
                  endif
                when 'link'
                  assign href = block.settings.link
                when 'chat'
                  if block.settings.whatsapp != blank
                    assign wa_digits = block.settings.whatsapp | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')'
                    assign href = 'https://wa.me/' | append: wa_digits
                  endif
              endcase
            -%}
            {%- if href != blank -%}
              <a class="ccard" href="{{ href }}" {% if block.type == 'chat' %}target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
                {% render 'maison-icon', icon: block.settings.icon %}
                <p class="t-label ccard__label">{{ block.settings.label }}</p>
                <p class="t-h3 ccard__title">{{ block.settings.title }}</p>
                {%- if block.settings.text != blank -%}<p class="t-body-s t-muted">{{ block.settings.text }}</p>{%- endif -%}
                <span class="cta">{{ block.settings.cta_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span></span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rencontrons-nous",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Contact" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Rencontrons-nous" }
  ],
  "blocks": [
    {
      "type": "phone",
      "name": "Téléphone",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "phone", "options": [{ "value": "phone", "label": "Téléphone" }] },
        { "type": "text", "id": "label", "label": "Label", "default": "Téléphone" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Une question ?" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "phone", "label": "Numéro", "info": "Ex. : +33123456789. La carte n'apparaît que si ce champ est rempli." },
        { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Appeler" }
      ]
    },
    {
      "type": "email",
      "name": "E-mail",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "mail", "options": [{ "value": "mail", "label": "E-mail" }] },
        { "type": "text", "id": "label", "label": "Label", "default": "E-mail" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Écrivez-nous" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "email", "label": "Adresse e-mail", "info": "La carte n'apparaît que si ce champ est rempli." },
        { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Écrire" }
      ]
    },
    {
      "type": "link",
      "name": "Rendez-vous",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "calendar", "options": [{ "value": "calendar", "label": "Rendez-vous" }] },
        { "type": "text", "id": "label", "label": "Label", "default": "Rendez-vous" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Rencontrons-nous" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "url", "id": "link", "label": "Lien", "info": "La carte n'apparaît que si ce champ est rempli." },
        { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Réservez" }
      ]
    },
    {
      "type": "chat",
      "name": "Live chat",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "chat", "options": [{ "value": "chat", "label": "Chat" }] },
        { "type": "text", "id": "label", "label": "Label", "default": "Live chat" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Là pour vous" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "whatsapp", "label": "Numéro WhatsApp", "info": "Format international sans le +, ex. : 33612345678. La carte n'apparaît que si ce champ est rempli." },
        { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Écrire sur WhatsApp" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rencontrons-nous",
      "blocks": [
        { "type": "phone" },
        { "type": "email" },
        { "type": "link" },
        { "type": "chat" }
      ]
    }
  ]
}
{% endschema %}
