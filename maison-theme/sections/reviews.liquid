{%- comment -%}
  MAISON — Avis clients
  N'affiche rien tant qu'aucun avis n'est configuré : pas de faux avis,
  pas de note inventée. Le client renseigne ses vrais avis dans l'éditeur.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="section reviews">
    <div class="page">
      <div class="reviews__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="t-h1 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
          {%- endif -%}
        </div>
        {%- if section.settings.average_rating != blank -%}
          <div class="reviews__average" data-reveal>
            <span class="t-display" style="font-size: clamp(2rem, 3vw, 2.75rem)">{{ section.settings.average_rating }}</span>
            <span class="t-body-s t-muted">/ 5{% if section.settings.review_count != blank %} · {{ section.settings.review_count }} {{ 'reviews.count' | t: default: 'avis' }}{% endif %}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="reviews__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <article class="reviews__card" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
              {%- if block.settings.rating != blank -%}
                <div class="reviews__stars" aria-label="{{ block.settings.rating }} / 5">
                  {%- assign rating_int = block.settings.rating | times: 1 -%}
                  {%- for i in (1..5) -%}
                    <span class="reviews__star{% if i <= rating_int %} is-filled{% endif %}" aria-hidden="true">★</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <p class="t-body-s reviews__text">{{ block.settings.text }}</p>
              <p class="t-label reviews__author">{{ block.settings.author }}</p>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Avis clients",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Avis clients" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce qu'ils en disent" },
    { "type": "text", "id": "average_rating", "label": "Note moyenne", "info": "Ex. : 4,9. Laissez vide si vous n'avez pas encore assez d'avis pour calculer une moyenne fiable." },
    { "type": "text", "id": "review_count", "label": "Nombre d'avis", "info": "Ex. : 128" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Texte de l'avis" },
        { "type": "text", "id": "author", "label": "Auteur", "info": "Ex. : Camille D., cliente vérifiée" }
      ]
    }
  ],
  "presets": [{ "name": "Avis clients" }]
}
{% endschema %}
